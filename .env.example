# mega-shot — API keys. Copy this file to .env in YOUR PROJECT folder (the folder you run xp in) and fill in what you use.
# Everything is optional except where noted. Keys are read from: environment variables > .env > .mega-shot/keys.env.
# Never commit .env, never paste keys into chat or issues.

# Stock footage / photos for `xp assets` (footage template). Free: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Second stock source (optional). Free: https://www.pexels.com/api/
PEXELS_API_KEY=

# `xp viral` research and `xp channel score` (optional). Google Cloud Console → enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=

# Tripo 3D (optional, paid third-party service used by tools/tripo.py)
TRIPO_API_KEY=

# Your own `xp social` webhook adapter token (optional) — name it whatever you pass to --token-env
# MY_HOOK_TOKEN=

# --- non-secret settings ---
# MS_PROJECT=/path/to/project     # project folder (otherwise: nearest folder with .mega-shot/, or the current folder)
# MS_BLENDER=/path/to/blender     # Blender executable for the blender template
# HUASHU_SKILL=/path/to/huashu-art-motion
# MS_ENCODER=x264                 # force the CPU encoder instead of in-browser WebCodecs
